{
  "name": "@securelink/crypto",
  "version": "0.1.1",
  "description": "SecureLink cryptographic primitives and abstractions",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.7.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "homepage": "https://secure-link-connection-docs.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grey-Wallet/SecureLinkConnection.git"
  },
  "bugs": {
    "url": "https://github.com/Grey-Wallet/SecureLinkConnection/issues"
  },
  "keywords": [
    "securelink",
    "security",
    "authentication",
    "anonymous",
    "customAuth",
    "attestation",
    "rate-limit",
    "crypto",
    "ed25519",
    "hmac"
  ]
}

{
  "name": "@securelink/web",
  "version": "0.1.0",
  "description": "SecureLink web client SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --platform browser",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@securelink/core": "workspace:*",
    "@securelink/protocol": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
